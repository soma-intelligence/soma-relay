# coturn for Soma Relay calls. Copy to turnserver.conf and edit.
listening-port=3478
tls-listening-port=5349
fingerprint
lt-cred-mech
# The node hands this user to every client through /v1/ice, so treat it as public and
# rely on the port range and peer restrictions below.
user=relay:CHANGE_ME
realm=relay.example.org
# external-ip=<public IPv4 of this machine>
min-port=49160
max-port=49200
no-cli
no-multicast-peers
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
