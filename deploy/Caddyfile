# TLS in front of relay-node. Set RELAY_HOSTS to your host name (or several, separated by
# commas), point their DNS at this machine, open ports 80 and 443. Caddy gets and renews the
# certificates on its own. docker-compose.yml also accepts the older RELAY_HOST.
{$RELAY_HOSTS:relay.example.org} {
	encode zstd gzip
	reverse_proxy relay-node:8080
}
